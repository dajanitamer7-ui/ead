{%- comment -%}
  Euro Auto Design — Trust-Building Homepage Section
  Shopify 2.0 compatible | sections/ead-trust-section.liquid
{%- endcomment -%}

{%- liquid
  assign accent     = section.settings.accent_color
  assign bg         = section.settings.background_color
  assign card_bg    = section.settings.card_background_color
  assign border_col = section.settings.border_color
  assign title_col  = section.settings.title_color
  assign text_col   = section.settings.text_color
  assign pt         = section.settings.padding_top
  assign pb         = section.settings.padding_bottom
-%}

{%- style -%}
  #ead-trust-{{ section.id }} {
    background-color: {{ bg }};
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
  }
  #ead-trust-{{ section.id }} .ead-trust__eyebrow { color: {{ accent }}; }
  #ead-trust-{{ section.id }} .ead-trust__eyebrow::before,
  #ead-trust-{{ section.id }} .ead-trust__eyebrow::after { background: {{ accent }}; }
  #ead-trust-{{ section.id }} .ead-trust__heading { color: {{ title_col }}; }
  #ead-trust-{{ section.id }} .ead-trust__subtitle { color: {{ text_col }}; }
  #ead-trust-{{ section.id }} .ead-trust__card {
    background-color: {{ card_bg }};
    border-color: {{ border_col }};
  }
  #ead-trust-{{ section.id }} .ead-trust__card:hover {
    border-color: {{ accent }};
    box-shadow: 0 0 0 1px {{ accent }}33, 0 12px 40px {{ accent }}18;
  }
  #ead-trust-{{ section.id }} .ead-trust__card-icon {
    color: {{ accent }};
    background: {{ accent }}14;
  }
  #ead-trust-{{ section.id }} .ead-trust__card:hover .ead-trust__card-icon {
    background: {{ accent }}22;
  }
  #ead-trust-{{ section.id }} .ead-trust__card-title { color: {{ title_col }}; }
  #ead-trust-{{ section.id }} .ead-trust__card-text { color: {{ text_col }}; }
  #ead-trust-{{ section.id }} .ead-trust__divider { background: {{ accent }}; }
{%- endstyle -%}

<section
  id="ead-trust-{{ section.id }}"
  class="ead-trust"
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="ead-trust__container">

    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="ead-trust__header ead-animate" style="--delay:0ms">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ead-trust__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="ead-trust__heading">{{ section.settings.title }}</h2>
        {%- endif -%}
        <span class="ead-trust__divider" aria-hidden="true"></span>
        {%- if section.settings.subtitle != blank -%}
          <p class="ead-trust__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="ead-trust__grid">
      {%- for block in section.blocks -%}
        {%- assign card_delay = forloop.index0 | times: 90 | plus: 100 -%}
        <article
          class="ead-trust__card ead-animate"
          style="--delay:{{ card_delay }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="ead-trust__card-icon" aria-hidden="true">
            {%- case block.settings.icon -%}

              {%- when 'diamond' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.7 10.3a2.41 2.41 0 0 0 0 3.41l7.59 7.59a2.41 2.41 0 0 0 3.41 0l7.59-7.59a2.41 2.41 0 0 0 0-3.41L13.7 2.71a2.41 2.41 0 0 0-3.41 0Z"/><line x1="12" x2="12" y1="2.5" y2="21.5"/><path d="M2.5 10.5h19"/></svg>

              {%- when 'shield' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>

              {%- when 'gauge' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v2"/><path d="m16.24 7.76-1.42 1.42"/><path d="M18 12h2"/><path d="M12 18v2"/><path d="m7.76 16.24 1.42-1.42"/><path d="M6 12H4"/><path d="m11.5 12.5 3.34-3.34"/><circle cx="12" cy="12" r="2"/></svg>

              {%- when 'headset' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>

              {%- when 'star' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>

              {%- when 'award' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>

              {%- when 'wrench' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>

              {%- when 'check-circle' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>

              {%- when 'users' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>

              {%- when 'zap' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>

              {%- when 'flag' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>

              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>

            {%- endcase -%}
          </div>

          {%- if block.settings.heading != blank -%}
            <h3 class="ead-trust__card-title">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="ead-trust__card-text">{{ block.settings.description }}</p>
          {%- endif -%}

          <span class="ead-trust__card-accent-line" aria-hidden="true"></span>
        </article>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* ── Scope & Reset ──────────────────────────────────────── */
  .ead-trust,
  .ead-trust *,
  .ead-trust *::before,
  .ead-trust *::after {
    box-sizing: border-box;
  }

  /* ── Section ────────────────────────────────────────────── */
  .ead-trust {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ead-trust__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .ead-trust__header {
    text-align: center;
    margin-bottom: 52px;
  }

  .ead-trust__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 14px;
    font-family: inherit;
  }

  .ead-trust__eyebrow::before,
  .ead-trust__eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    opacity: 0.55;
    flex-shrink: 0;
  }

  .ead-trust__heading {
    font-size: clamp(20px, 2.6vw, 28px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 16px;
    font-family: inherit;
  }

  .ead-trust__divider {
    display: block;
    width: 40px;
    height: 2px;
    margin: 0 auto 16px;
    border-radius: 2px;
    opacity: 0.7;
  }

  .ead-trust__subtitle {
    font-size: 14.5px;
    line-height: 1.65;
    opacity: 0.6;
    max-width: 500px;
    margin: 0 auto;
    font-family: inherit;
  }

  /* ── Grid ───────────────────────────────────────────────── */
  .ead-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  /* ── Card ───────────────────────────────────────────────── */
  .ead-trust__card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 22px 32px;
    border-radius: 14px;
    border: 1px solid transparent;
    overflow: hidden;
    cursor: default;
    transition:
      transform 0.32s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.32s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.32s ease;
  }

  /* Subtle inner gradient overlay for depth */
  .ead-trust__card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(145deg, rgba(255,255,255,0.025) 0%, transparent 60%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .ead-trust__card:hover {
      transform: translateY(-5px);
    }
  }

  /* Gold accent line that slides up on hover */
  .ead-trust__card-accent-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 0 0 14px 14px;
    background: currentColor;
    opacity: 0;
    transform: scaleX(0.4);
    transform-origin: left;
    transition:
      opacity 0.3s ease,
      transform 0.32s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .ead-trust__card:hover .ead-trust__card-accent-line {
    opacity: 0.75;
    transform: scaleX(1);
  }

  /* ── Card Icon ──────────────────────────────────────────── */
  .ead-trust__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    margin-bottom: 20px;
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .ead-trust__card-icon svg {
    width: 26px;
    height: 26px;
    display: block;
    flex-shrink: 0;
  }

  /* ── Card Text ──────────────────────────────────────────── */
  .ead-trust__card-title {
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.005em;
    line-height: 1.3;
    margin: 0 0 10px;
    font-family: inherit;
  }

  .ead-trust__card-text {
    font-size: 13px;
    line-height: 1.7;
    opacity: 0.68;
    margin: 0;
    font-family: inherit;
    flex: 1;
  }

  /* ── Viewport Fade-Up Animation ─────────────────────────── */
  .ead-animate {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    transition-delay: var(--delay, 0ms);
    will-change: opacity, transform;
  }

  .ead-animate.ead-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive: Tablet ─────────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .ead-trust__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  /* ── Responsive: Mobile ─────────────────────────────────── */
  @media screen and (max-width: 600px) {
    .ead-trust__container {
      padding: 0 16px;
    }
    .ead-trust__header {
      margin-bottom: 36px;
    }
    .ead-trust__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .ead-trust__card {
      padding: 20px 16px 24px;
      border-radius: 10px;
    }
    .ead-trust__card-icon {
      width: 40px;
      height: 40px;
      margin-bottom: 14px;
      border-radius: 8px;
    }
    .ead-trust__card-icon svg {
      width: 22px;
      height: 22px;
    }
    .ead-trust__card-title {
      font-size: 13px;
    }
    .ead-trust__card-text {
      font-size: 11.5px;
    }
  }

  /* ── Reduced Motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ead-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ead-trust__card,
    .ead-trust__card-accent-line {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    function runTrustSection(id) {
      var section = document.getElementById('ead-trust-' + id);
      if (!section) return;

      var els = section.querySelectorAll('.ead-animate');
      if (!els.length) return;

      if (!('IntersectionObserver' in window)) {
        Array.prototype.forEach.call(els, function (el) {
          el.classList.add('ead-visible');
        });
        return;
      }

      var io = new IntersectionObserver(
        function (entries) {
          Array.prototype.forEach.call(entries, function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('ead-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -32px 0px' }
      );

      Array.prototype.forEach.call(els, function (el) { io.observe(el); });
    }

    // Initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        runTrustSection('{{ section.id }}');
      });
    } else {
      runTrustSection('{{ section.id }}');
    }

    // Shopify theme editor: re-run when section reloads
    document.addEventListener('shopify:section:load', function (e) {
      if (e && e.detail && e.detail.sectionId === '{{ section.id }}') {
        runTrustSection('{{ section.id }}');
      }
    });
  }());
</script>

