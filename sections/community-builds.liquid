{% comment %}
  Euro Auto Design — Built by Our Community
  Premium angled card strip showcasing customer builds.
  OS 2.0 | Fully customizable via the theme editor.
{% endcomment %}

{%- liquid
  assign section_id     = 'ead-cb-' | append: section.id
  assign blocks         = section.blocks
  assign block_count    = blocks.size

  assign pt_desk        = section.settings.padding_top_desktop      | append: 'px'
  assign pb_desk        = section.settings.padding_bottom_desktop   | append: 'px'
  assign pt_mob         = section.settings.padding_top_mobile       | append: 'px'
  assign pb_mob         = section.settings.padding_bottom_mobile    | append: 'px'

  assign gallery_h      = section.settings.gallery_height_desktop
  assign card_h_mob     = section.settings.card_height_mobile
  assign card_gap       = section.settings.card_gap_desktop
  assign card_gap_mob   = section.settings.card_gap_mobile
  assign slant          = section.settings.slant_strength
  assign radius         = section.settings.card_radius
  assign overlay        = section.settings.overlay_darkness         | divided_by: 100.0
  assign accent_w       = section.settings.accent_line_width

  assign mobile_layout  = section.settings.mobile_layout
  assign hover_enabled  = section.settings.enable_hover
-%}

<style>
  #{{ section_id }} {
    --cb-bg:            {{ section.settings.bg_color }};
    --cb-text:          {{ section.settings.text_color }};
    --cb-muted:         rgba(0,0,0,.62);
    --cb-line-a:        #111111;
    --cb-line-b:        #6F6F6F;
    --cb-line-c:        #D6D6D6;
    --cb-card-radius:   {{ radius }}px;
    --cb-slant:         {{ slant }}px;
    --cb-gap:           {{ card_gap }}px;
    --cb-gap-mob:       {{ card_gap_mob }}px;
    --cb-gallery-h:     {{ gallery_h }}px;
    --cb-card-h-mob:    {{ card_h_mob }}px;
    --cb-overlay:       {{ overlay }};

    /* Typography — desktop */
    --cb-fs-eyebrow:    {{ section.settings.eyebrow_size_desktop }}px;
    --cb-fs-heading:    {{ section.settings.heading_size_desktop }}px;
    --cb-fs-support:    {{ section.settings.support_size_desktop }}px;
    --cb-fs-model:      {{ section.settings.model_size_desktop }}px;
    --cb-fs-name:       {{ section.settings.name_size_desktop }}px;
    --cb-fs-handle:     {{ section.settings.handle_size_desktop }}px;
    --cb-fs-location:   {{ section.settings.location_size_desktop }}px;
    --cb-fs-cta:        {{ section.settings.cta_size_desktop }}px;

    /* Weights */
    --cb-fw-eyebrow:    {{ section.settings.eyebrow_weight }};
    --cb-fw-heading:    {{ section.settings.heading_weight }};
    --cb-fw-model:      {{ section.settings.model_weight }};
    --cb-fw-name:       {{ section.settings.name_weight }};

    /* Letter spacing */
    --cb-ls-eyebrow:    {{ section.settings.eyebrow_tracking }}em;
    --cb-ls-heading:    {{ section.settings.heading_tracking }}em;
    --cb-ls-label:      {{ section.settings.label_tracking }}em;
  }

  #{{ section_id }} {
    background-color: var(--cb-bg);
    color: var(--cb-text);
    padding: {{ pt_desk }} 0 {{ pb_desk }};
    font-family: inherit;
    box-sizing: border-box;
    overflow: hidden;
  }
  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after { box-sizing: inherit; }

  .ead-cb__inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ─── Header ───────────────────────────────────────────────── */
  .ead-cb__header {
    text-align: center;
    margin: 0 auto 40px;
    max-width: 760px;
  }
  .ead-cb__eyebrow {
    display: inline-block;
    margin: 0 0 14px;
    font-size: var(--cb-fs-eyebrow);
    font-weight: var(--cb-fw-eyebrow);
    letter-spacing: var(--cb-ls-eyebrow);
    text-transform: uppercase;
    color: var(--cb-muted);
  }
  .ead-cb__heading {
    margin: 0 0 14px;
    font-size: var(--cb-fs-heading);
    font-weight: var(--cb-fw-heading);
    letter-spacing: var(--cb-ls-heading);
    color: var(--cb-text);
    line-height: 1.1;
  }
  .ead-cb__support {
    margin: 18px auto 0;
    font-size: var(--cb-fs-support);
    color: var(--cb-muted);
    line-height: 1.5;
    max-width: 580px;
  }
  .ead-cb__accent {
    display: block;
    width: {{ accent_w }}px;
    max-width: 60%;
    height: 2px;
    margin: 18px auto 0;
    background: linear-gradient(90deg, var(--cb-line-a) 0%, var(--cb-line-b) 50%, var(--cb-line-c) 100%);
    border-radius: 2px;
  }

  /* ─── Gallery — Desktop angled strip ───────────────────────── */
  .ead-cb__strip {
    display: flex;
    width: 100%;
    height: var(--cb-gallery-h);
    gap: var(--cb-gap);
    margin-top: 8px;
  }

  .ead-cb__card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    background: #111;
    border-radius: var(--cb-card-radius);
    transition: transform .5s ease, filter .5s ease, box-shadow .5s ease;
    isolation: isolate;
  }

  /* Connected angled strip: overlap by slant so diagonal edges meet.
     Applied only when desktop gap is 0 and slant > 0. */
  {% if card_gap == 0 and slant > 0 %}
  .ead-cb__strip.is-connected .ead-cb__card + .ead-cb__card {
    margin-left: calc(var(--cb-slant) * -1);
  }
  {% endif %}

  .ead-cb__card img,
  .ead-cb__card .ead-cb__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .7s ease;
    z-index: 0;
  }

  .ead-cb__placeholder {
    background:
      linear-gradient(135deg, #1a1a1a 0%, #2b2b2b 50%, #1a1a1a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ead-cb__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 45%,
      rgba(0,0,0,calc(var(--cb-overlay) * 0.55)) 70%,
      rgba(0,0,0,var(--cb-overlay)) 100%
    );
    pointer-events: none;
    transition: opacity .4s ease;
  }

  /* Hover */
  {% if hover_enabled %}
  .ead-cb__card:hover img { transform: scale(1.04); }
  .ead-cb__card:hover {
    box-shadow:
      inset 0 0 0 1px rgba(214,214,214,.65),
      0 0 0 1px rgba(111,111,111,.25),
      0 10px 30px rgba(0,0,0,.18);
  }
  {% endif %}

  /* Card content */
  .ead-cb__content {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 2;
    padding: 22px 26px 24px;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
  }
  .ead-cb__content > * { pointer-events: auto; }

  .ead-cb__model {
    font-size: var(--cb-fs-model);
    font-weight: var(--cb-fw-model);
    letter-spacing: var(--cb-ls-label);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
  }
  .ead-cb__name {
    font-size: var(--cb-fs-name);
    font-weight: var(--cb-fw-name);
    margin: 0;
    color: rgba(255,255,255,.92);
    line-height: 1.3;
  }
  .ead-cb__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 6px;
    font-size: var(--cb-fs-handle);
    color: rgba(255,255,255,.78);
    letter-spacing: 0.02em;
  }
  .ead-cb__handle,
  .ead-cb__location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ead-cb__handle a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,.25);
    transition: border-color .25s ease, color .25s ease;
  }
  .ead-cb__handle a:hover {
    color: #fff;
    border-bottom-color: rgba(214,214,214,.9);
  }
  .ead-cb__location {
    font-size: var(--cb-fs-location);
  }
  .ead-cb__cta {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--cb-fs-cta);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    align-self: flex-start;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(214,214,214,.7);
    transition: gap .25s ease, border-color .25s ease;
  }
  .ead-cb__cta:hover { gap: 12px; border-bottom-color: #fff; }
  .ead-cb__cta::after {
    content: '→';
    font-weight: 400;
    transform: translateY(-1px);
  }

  /* ─── Tablet (≤ 1024px) ────────────────────────────────────── */
  @media (max-width: 1024px) {
    .ead-cb__strip {
      height: auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .ead-cb__strip .ead-cb__card + .ead-cb__card { margin-left: 0; }
    .ead-cb__card {
      height: 320px;
      clip-path: none !important;
    }
  }

  /* ─── Mobile ───────────────────────────────────────────────── */
  @media (max-width: 749px) {
    #{{ section_id }} { padding: {{ pt_mob }} 0 {{ pb_mob }}; }
    .ead-cb__inner { padding: 0 16px; }
    .ead-cb__header { margin-bottom: 28px; }
    .ead-cb__eyebrow  { font-size: {{ section.settings.eyebrow_size_mobile }}px; }
    .ead-cb__heading  { font-size: {{ section.settings.heading_size_mobile }}px; }
    .ead-cb__support  { font-size: {{ section.settings.support_size_mobile }}px; }
    .ead-cb__model    { font-size: {{ section.settings.model_size_mobile }}px; }
    .ead-cb__name     { font-size: {{ section.settings.name_size_mobile }}px; }
    .ead-cb__handle,
    .ead-cb__meta     { font-size: {{ section.settings.handle_size_mobile }}px; }
    .ead-cb__location { font-size: {{ section.settings.location_size_mobile }}px; }
    .ead-cb__cta      { font-size: {{ section.settings.cta_size_mobile }}px; }

    {% if mobile_layout == 'stacked' %}
    .ead-cb__strip {
      display: flex;
      flex-direction: column;
      gap: var(--cb-gap-mob);
      height: auto;
    }
    .ead-cb__card {
      height: var(--cb-card-h-mob);
      clip-path: none !important;
      margin-left: 0 !important;
    }
    {% else %}
    .ead-cb__strip {
      display: flex;
      flex-direction: row;
      gap: var(--cb-gap-mob);
      height: auto;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
      scrollbar-width: thin;
    }
    .ead-cb__strip::-webkit-scrollbar { height: 4px; }
    .ead-cb__strip::-webkit-scrollbar-thumb { background: #c9c9c9; border-radius: 4px; }
    .ead-cb__card {
      flex: 0 0 82%;
      height: var(--cb-card-h-mob);
      clip-path: none !important;
      margin-left: 0 !important;
      scroll-snap-align: start;
    }
    {% endif %}

    .ead-cb__content { padding: 18px 18px 18px; }
  }

  /* ─── Overflow guard for 6+ cards on desktop ───────────────── */
  {% if block_count > 5 %}
  @media (min-width: 1025px) {
    .ead-cb__strip {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .ead-cb__card {
      flex: 0 0 calc((100% / 4) + (var(--cb-slant) / 4));
      scroll-snap-align: start;
    }
  }
  {% endif %}

  /* ─── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ead-cb__card,
    .ead-cb__card img,
    .ead-cb__cta { transition: none !important; }
    .ead-cb__card:hover img { transform: none !important; }
  }
</style>

<section id="{{ section_id }}" class="ead-cb">
  <div class="ead-cb__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.support_text != blank -%}
      <header class="ead-cb__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ead-cb__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ead-cb__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.show_accent -%}
          <span class="ead-cb__accent" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.support_text != blank -%}
          <p class="ead-cb__support">{{ section.settings.support_text }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if block_count > 0 -%}
      {%- assign strip_class = 'ead-cb__strip' -%}
      {%- if card_gap == 0 and slant > 0 -%}
        {%- assign strip_class = strip_class | append: ' is-connected' -%}
      {%- endif -%}

      <div class="{{ strip_class }}" role="list">
        {%- for block in blocks -%}
          {%- liquid
            assign idx = forloop.index0
            assign last_idx = block_count | minus: 1

            assign slant_dir = block.settings.slant_direction
            if slant_dir == 'auto'
              if idx == 0
                assign slant_dir = 'right'
              elsif idx == last_idx
                assign slant_dir = 'left'
              else
                assign slant_dir = 'both'
              endif
            endif

            if block.settings.force_square
              assign slant_dir = 'none'
            endif

            assign card_clip = ''
            case slant_dir
              when 'right'
                assign card_clip = 'polygon(0 0, 100% 0, calc(100% - var(--cb-slant)) 100%, 0 100%)'
              when 'left'
                assign card_clip = 'polygon(var(--cb-slant) 0, 100% 0, 100% 100%, 0 100%)'
              when 'both'
                assign card_clip = 'polygon(var(--cb-slant) 0, 100% 0, calc(100% - var(--cb-slant)) 100%, 0 100%)'
              else
                assign card_clip = 'none'
            endcase

            assign has_ig_url    = false
            if block.settings.instagram_url != blank
              assign has_ig_url = true
            endif

            assign img       = block.settings.image
            assign img_mob   = block.settings.image_mobile
            assign alt_text  = block.settings.alt | default: block.settings.customer_name
          -%}

          <article
            class="ead-cb__card"
            role="listitem"
            style="clip-path: {{ card_clip }}; -webkit-clip-path: {{ card_clip }};"
            {{ block.shopify_attributes }}
          >
            {%- if img != blank -%}
              <img
                src="{{ img | image_url: width: 1400 }}"
                srcset="{{ img | image_url: width: 600 }} 600w,
                        {{ img | image_url: width: 900 }} 900w,
                        {{ img | image_url: width: 1200 }} 1200w,
                        {{ img | image_url: width: 1600 }} 1600w"
                sizes="(max-width: 749px) 90vw, (max-width: 1024px) 50vw, 25vw"
                alt="{{ alt_text | escape }}"
                loading="lazy"
                width="{{ img.width }}"
                height="{{ img.height }}"
                class="ead-cb__img ead-cb__img--desk"
              >
              {%- if img_mob != blank -%}
                <img
                  src="{{ img_mob | image_url: width: 900 }}"
                  alt="{{ alt_text | escape }}"
                  loading="lazy"
                  width="{{ img_mob.width }}"
                  height="{{ img_mob.height }}"
                  class="ead-cb__img ead-cb__img--mob"
                  style="display:none;"
                >
              {%- endif -%}
            {%- else -%}
              <div class="ead-cb__placeholder" aria-hidden="true">Build Image</div>
            {%- endif -%}

            <div class="ead-cb__content">
              {%- if block.settings.model_label != blank -%}
                <p class="ead-cb__model">{{ block.settings.model_label }}</p>
              {%- endif -%}

              {%- if block.settings.customer_name != blank -%}
                <p class="ead-cb__name">{{ block.settings.customer_name }}</p>
              {%- endif -%}

              {%- if block.settings.instagram_handle != blank or block.settings.location != blank -%}
                <div class="ead-cb__meta">
                  {%- if block.settings.instagram_handle != blank -%}
                    {%- assign handle = block.settings.instagram_handle | remove: '@' -%}
                    <span class="ead-cb__handle">
                      {%- if has_ig_url -%}
                        <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">@{{ handle }}</a>
                      {%- else -%}
                        @{{ handle }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.location != blank -%}
                    <span class="ead-cb__location">{{ block.settings.location }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
                <a class="ead-cb__cta" href="{{ block.settings.cta_link }}">{{ block.settings.cta_text }}</a>
              {%- elsif block.settings.cta_text != blank -%}
                <span class="ead-cb__cta" role="text">{{ block.settings.cta_text }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="ead-cb__inner" style="text-align:center;color:var(--cb-muted);padding:40px 0;">
        Add customer build cards in the theme editor to populate this section.
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Built by Our Community",
  "tag": "section",
  "class": "ead-community-builds",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Header Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILT BY OUR COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Builds, Real Results"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Supporting text",
      "default": "Explore real Euro Auto Design builds from enthusiasts across the community."
    },
    {
      "type": "checkbox",
      "id": "show_accent",
      "label": "Show accent line under heading",
      "default": true
    },
    {
      "type": "range",
      "id": "accent_line_width",
      "label": "Accent line width",
      "min": 40, "max": 240, "step": 4, "unit": "px",
      "default": 96
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0A0A0A"
    },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0, "max": 200, "step": 4, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 56
    },

    { "type": "header", "content": "Gallery" },
    {
      "type": "range",
      "id": "gallery_height_desktop",
      "label": "Desktop gallery height",
      "min": 320, "max": 720, "step": 10, "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Mobile card height",
      "min": 240, "max": 560, "step": 10, "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "label": "Desktop card gap",
      "info": "Set to 0 for a connected angled strip.",
      "min": 0, "max": 40, "step": 1, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Mobile card gap",
      "min": 0, "max": 40, "step": 1, "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "slant_strength",
      "label": "Card slant strength",
      "min": 0, "max": 160, "step": 2, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0, "max": 24, "step": 1, "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Card overlay darkness",
      "min": 0, "max": 100, "step": 5, "unit": "%",
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "enable_hover",
      "label": "Enable hover animation",
      "default": true
    },

    { "type": "header", "content": "Mobile Layout" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "stacked",  "label": "Stacked" },
        { "value": "carousel", "label": "Horizontal carousel" }
      ],
      "default": "stacked"
    },

    { "type": "header", "content": "Typography — Desktop" },
    { "type": "range", "id": "eyebrow_size_desktop",  "label": "Eyebrow size",          "min": 10, "max": 22, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size_desktop",  "label": "Heading size",          "min": 24, "max": 80, "step": 1, "unit": "px", "default": 44 },
    { "type": "range", "id": "support_size_desktop",  "label": "Supporting text size",  "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "model_size_desktop",    "label": "Vehicle/model size",    "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "name_size_desktop",     "label": "Customer name size",    "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "handle_size_desktop",   "label": "Instagram handle size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },
